diff --git a/packages/seroval/src/core/context/error-path.ts b/packages/seroval/src/core/context/error-path.ts
new file mode 100644
index 00000000..c596eee0
--- /dev/null
+++ b/packages/seroval/src/core/context/error-path.ts
@@ -0,0 +1,14 @@
+/**
+ * Spike prototype: adds the key of one level to an error that passes up
+ * through a parser. Runs only on throw.
+ */
+export function prependErrorPath(error: unknown, segment: string | number): void {
+  if (typeof error === 'object' && error !== null) {
+    const target = error as { path?: (string | number)[] };
+    if (target.path) {
+      target.path.unshift(segment);
+    } else {
+      target.path = [segment];
+    }
+  }
+}
