// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FormData > crossSerialize > scoped > supports FormData 1`] = `
"($R=>$R[0]=($R[1]=(e, f = new FormData(), i = 0, s = e.length, t) => {
	for (; i < s; i++) {
		t = e[i];
		f.append(t[0], t[1]);
	};
	return f;
})($R[2]=[$R[3]=["hello","world"],$R[4]=["foo","bar"]]))($R["example"])"
`;

