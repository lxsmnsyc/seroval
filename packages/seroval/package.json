{
  "name": "seroval",
  "type": "module",
  "sideEffects": false,
  "version": "1.7.3",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "pridepack",
    "solid-js",
    "tanstack",
    "serialization"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "esbuild": "^0.28.2",
    "temporal-polyfill": "^1.0.6",
    "ts-prune": "^0.10.3",
    "tsdown": "^0.23.1",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "prepublishOnly": "tsdown",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.include='src/**'",
    "test:ui": "vitest --ui",
    "prune": "ts-prune"
  },
  "private": false,
  "description": "Stringify JS values",
  "repository": {
    "url": "https://github.com/lxsmnsyc/seroval.git",
    "type": "git"
  },
  "homepage": "https://seroval.vercel.app",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/seroval/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Alexis Munsayac",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "development": {
        "browser": {
          "import": "./dist/dev/index.js",
          "require": "./dist/dev/index.cjs",
          "default": "./dist/dev/index.js"
        },
        "import": "./dist/dev/index.js",
        "require": "./dist/dev/index.cjs",
        "default": "./dist/dev/index.js"
      },
      "browser": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./binary": {
      "development": {
        "browser": {
          "import": "./dist/dev/binary.js",
          "require": "./dist/dev/binary.cjs",
          "default": "./dist/dev/binary.js"
        },
        "import": "./dist/dev/binary.js",
        "require": "./dist/dev/binary.cjs",
        "default": "./dist/dev/binary.js"
      },
      "browser": {
        "import": "./dist/binary.js",
        "require": "./dist/binary.cjs",
        "default": "./dist/binary.js"
      },
      "import": "./dist/binary.js",
      "require": "./dist/binary.cjs",
      "default": "./dist/binary.js"
    },
    "./validator": {
      "development": {
        "browser": {
          "import": "./dist/dev/validator.js",
          "require": "./dist/dev/validator.cjs",
          "default": "./dist/dev/validator.js"
        },
        "import": "./dist/dev/validator.js",
        "require": "./dist/dev/validator.cjs",
        "default": "./dist/dev/validator.js"
      },
      "browser": {
        "import": "./dist/validator.js",
        "require": "./dist/validator.cjs",
        "default": "./dist/validator.js"
      },
      "import": "./dist/validator.js",
      "require": "./dist/validator.cjs",
      "default": "./dist/validator.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js"
}
