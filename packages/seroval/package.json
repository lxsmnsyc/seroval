{
  "name": "seroval",
  "type": "module",
  "sideEffects": false,
  "version": "1.6.7",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "pridepack",
    "solid-js",
    "tanstack",
    "serialization"
  ],
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/ui": "^5.0.2",
    "esbuild": "^0.28.2",
    "temporal-polyfill": "^1.0.5",
    "ts-prune": "^0.10.3",
    "tsdown": "^0.23.0",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "prepublishOnly": "tsdown",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "prune": "ts-prune"
  },
  "private": false,
  "description": "Stringify JS values",
  "repository": {
    "url": "https://github.com/lxsmnsyc/seroval.git",
    "type": "git"
  },
  "homepage": "https://github.com/lxsmnsyc/seroval/tree/main/packages/seroval",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/seroval/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Alexis Munsayac",
  "types": "./dist/index.d.cts",
  "imports": {
    "#seroval-binary": {
      "types": "./dist/binary-neutral.d.ts",
      "development": {
        "browser": {
          "import": "./dist/dev/binary-browser.js",
          "require": "./dist/dev/binary-browser.cjs",
          "default": "./dist/dev/binary-browser.js"
        },
        "default": {
          "import": "./dist/dev/binary-neutral.js",
          "require": "./dist/dev/binary-neutral.cjs",
          "default": "./dist/dev/binary-neutral.js"
        }
      },
      "browser": {
        "import": "./dist/binary-browser.js",
        "require": "./dist/binary-browser.cjs",
        "default": "./dist/binary-browser.js"
      },
      "default": {
        "import": "./dist/binary-neutral.js",
        "require": "./dist/binary-neutral.cjs",
        "default": "./dist/binary-neutral.js"
      }
    }
  },
  "exports": {
    ".": {
      "development": {
        "import": "./dist/dev/index.js",
        "require": "./dist/dev/index.cjs",
        "default": "./dist/dev/index.js"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js"
}
