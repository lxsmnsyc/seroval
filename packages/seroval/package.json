{
  "name": "seroval",
  "version": "1.6.1",
  "private": false,
  "description": "Stringify JS values",
  "keywords": [
    "pridepack",
    "serialization",
    "solid-js",
    "tanstack"
  ],
  "homepage": "https://github.com/lxsmnsyc/seroval/tree/main/packages/seroval",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/seroval/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/seroval.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {}
  },
  "exports": {
    ".": {
      "development": {
        "import": "./dist/dev/index.js",
        "require": "./dist/dev/index.cjs",
        "default": "./dist/dev/index.js"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "tsdown",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "prune": "ts-prune"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/ui": "^4.1.10",
    "esbuild": "^0.28.1",
    "temporal-polyfill": "^1.0.3",
    "ts-prune": "^0.10.3",
    "tsdown": "^0.22.14",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=10"
  }
}
