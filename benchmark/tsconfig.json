{
  "exclude": ["node_modules", "build", "results"],
  "include": ["src", "reports", "*.js", "*.mjs"],
  "compilerOptions": {
    "module": "ESNext",
    "lib": ["ESNext"],
    "types": ["node"],
    "allowJs": true,
    "noEmit": true,
    "importHelpers": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "./",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "bundler",
    "jsx": "react",
    "esModuleInterop": true,
    "target": "ESNext"
  }
}
